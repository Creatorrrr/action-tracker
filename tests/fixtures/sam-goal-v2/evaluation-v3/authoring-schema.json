        {
          "pattern": "^/clips/[A-Za-z0-9._-]+/windowsById/[A-Za-z0-9][A-Za-z0-9._-]{0,63}(/(startFrameIndex|endFrameIndexExclusive|purposeTags|scenarioTags))?$",
