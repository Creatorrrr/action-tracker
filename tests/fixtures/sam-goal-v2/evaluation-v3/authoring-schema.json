          "$ref": "#/$defs/sha256"
        },
        "reviewAPseudonymSha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewBByteSha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewBCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewBPseudonymSha256": {
