        "reviewAByteSha256",
        "reviewAPseudonymSha256",
        "reviewBCanonicalSha256",
        "reviewBByteSha256",
        "reviewBPseudonymSha256",
        "windows",
        "disagreements",
        "decisions",
        "expectedCanonicalHash"
