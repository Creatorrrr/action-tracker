    "disagreementPath": {
      "oneOf": [
        {
          "pattern": "^/clips/[A-Za-z0-9._-]+/segments/(0|[1-9][0-9]*)-([1-9][0-9]*)/(scenarios|presence|personState|occlusion/(body|leftFoot|rightFoot|leftHand|rightHand)|contact/(left|right)|handObservability/(left|right)|endpointObservability/(leftWrist|rightWrist|leftAnkle|rightAnkle|head)|subjectSelection/(state|manualTargetId|anchor))$",
          "type": "string"
