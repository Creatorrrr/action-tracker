        {
          "additionalProperties": false,
          "properties": {
            "x": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "y": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "type": "object"
        }
      ]
    },
    "anchorPath": {
      "pattern": "^/clips/[A-Za-z0-9._-]+/segments/(0|[1-9][0-9]*)-([1-9][0-9]*)/subjectSelection/anchor$",
      "type": "string"
    },
    "clipReview": {
      "additionalProperties": false,
