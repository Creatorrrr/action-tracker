{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://action-tracker.invalid/sam-goal/manual-review-operations/access-evidence-v1.schema.json",
  "title": "SAM Goal deny-default review access evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "authorityClass", "compilerInput", "p0Authority", "cycleId", "mode", "actorPseudonymSha256", "presentationContractSha256", "bundleManifestByteSha256", "immutableAssetSetSha256", "fixedInputSetSha256", "sessionSeedByteSha256", "sessionFinalStateByteSha256", "editJournalByteSha256", "actorAttestationByteSha256", "filesystemAllowlist", "networkAllowlist", "actualOpenEvents", "cspHeaders", "negativeProbeResults", "outsideInputAttestation"],
  "properties": {
    "artifactType": {"const": "sam-goal-review-access-evidence-v1"},
    "schemaVersion": {"const": 1},
    "authorityClass": {"const": "process-evidence-only"},
    "compilerInput": {"const": false},
    "p0Authority": {"const": false},
    "cycleId": {"$ref": "bundle-manifest-v1.schema.json#/$defs/cycleId"},
    "mode": {"$ref": "bundle-manifest-v1.schema.json#/$defs/mode"},
    "actorPseudonymSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "presentationContractSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "bundleManifestByteSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "immutableAssetSetSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "fixedInputSetSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "sessionSeedByteSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "sessionFinalStateByteSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "editJournalByteSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "actorAttestationByteSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "filesystemAllowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "bundle-manifest-v1.schema.json#/$defs/logicalPath"}},
    "networkAllowlist": {"const": ["127.0.0.1", "::1", "localhost"]},
    "actualOpenEvents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/openEvent"}},
    "cspHeaders": {"$ref": "#/$defs/cspHeaders"},
    "negativeProbeResults": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/probe"}},
    "outsideInputAttestation": {"$ref": "#/$defs/attestation"}
  },
  "$defs": {
    "openEvent": {"type": "object", "additionalProperties": false, "required": ["sequence", "logicalPath", "operation", "result"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "logicalPath": {"type": "string", "minLength": 1}, "operation": {"enum": ["read", "write", "connect", "bind", "lock", "unlock"]}, "result": {"enum": ["allowed", "denied"]}}},
    "cspHeaders": {"type": "object", "additionalProperties": false, "required": ["content-security-policy"], "properties": {"content-security-policy": {"const": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; media-src 'self' blob:; connect-src 'self' http://127.0.0.1:*; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"}}},
    "probe": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["name", "attempted", "denied"], "properties": {"name": {"const": "host-repository"}, "attempted": {"const": true}, "denied": {"const": true}}},
      {"type": "object", "additionalProperties": false, "required": ["name", "attempted", "denied"], "properties": {"name": {"const": "sibling-bundle"}, "attempted": {"const": true}, "denied": {"const": true}}},
      {"type": "object", "additionalProperties": false, "required": ["name", "attempted", "denied", "host"], "properties": {"name": {"const": "non-loopback"}, "attempted": {"const": true}, "denied": {"const": true}, "host": {"const": "198.51.100.1"}}}
    ]},
    "attestation": {"type": "object", "additionalProperties": false, "required": ["coordinatorProvidedRuntimeDataAfterSpawn", "actorDeclaredNoOutsideInput"], "properties": {"coordinatorProvidedRuntimeDataAfterSpawn": {"const": false}, "actorDeclaredNoOutsideInput": {"const": true}}}
  }
}
