{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://action-tracker.invalid/sam-goal/manual-review-operations/review-export-receipt-v1.schema.json",
  "title": "SAM Goal sealed raw-review export receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "authorityClass", "compilerInput", "p0Authority", "cycleId", "role", "actorPseudonymSha256", "publicPins", "sourceBinding", "rulebookByteSha256", "presentationContractSha256", "bundleManifestByteSha256", "accessEvidenceByteSha256", "editJournalByteSha256", "formalReviewByteSha256", "formalReviewCanonicalSha256", "validatorInterfaceId", "validatorExitCode", "validatorStdoutByteSha256", "validatorStdoutBase64", "sessionTreeSha256"],
  "properties": {
    "artifactType": {"const": "sam-goal-review-export-receipt-v1"},
    "schemaVersion": {"const": 1},
    "authorityClass": {"const": "process-evidence-only"},
    "compilerInput": {"const": false},
    "p0Authority": {"const": false},
    "cycleId": {"$ref": "bundle-manifest-v1.schema.json#/$defs/cycleId"},
    "role": {"$ref": "bundle-manifest-v1.schema.json#/$defs/reviewMode"},
    "actorPseudonymSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "publicPins": {"$ref": "bundle-manifest-v1.schema.json#/$defs/publicPins"},
    "sourceBinding": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sourceBinding"},
    "rulebookByteSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "presentationContractSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "bundleManifestByteSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "accessEvidenceByteSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "editJournalByteSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "formalReviewByteSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "formalReviewCanonicalSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "validatorInterfaceId": {"const": "sam_goal.manual_pack_compiler_v3/manual-pack-review-validator-cli"},
    "validatorExitCode": {"const": 0},
    "validatorStdoutByteSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"},
    "validatorStdoutBase64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
    ,"sessionTreeSha256": {"$ref": "bundle-manifest-v1.schema.json#/$defs/sha256"}
  }
}
