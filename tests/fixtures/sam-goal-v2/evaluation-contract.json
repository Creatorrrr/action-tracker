  "manualCoverage": {
    "minimumCompleteCoverage": 0.95,
    "denominator": "all decoded exact PTS in the union of required windows",
    "numerator": "denominator PTS with one unambiguous label for every required dimension",
    "teacherInvalidMayReduceDenominator": false,
    "absentMayReduceDenominator": false,
    "unknownCountsAsComplete": true,
    "unknownCountsAsKnown": false,
    "knownCoverageReportedPerDimension": true,
    "decodeUnavailableExclusion": {
      "allowed": true,
      "requiresMachineReason": true,
      "preservedInDecoderManifest": true
    }
  },
  "contact": {
    "feet": [
      "left",
      "right"
    ],
    "classes": [
      "planted",
      "moving",
      "unknown"
    ],
    "minimumTeacherValidObservableFramesPerFootAndKnownClass": 100,
    "unknownExcludedFromF1": true,
    "outOfFrameExcludedFromF1": true,
    "coverageReportedPerFoot": true,
    "finalMetric": "per-foot planted/moving F1 followed by left/right macro average"
  },
  "presence": {
    "classes": [
      "present",
      "absent",
      "unknown"
    ],
    "finalMetric": "present/absent F1 per clip followed by clip macro average",
    "clipsWithoutAbsentLabelsExcludedFromMacro": true,
    "excludedClipCoverageMustBeReported": true
  },
  "reacquire": {
    "minimumPriorAbsentOrUnreliableMs": 200,
    "start": "first teacher-valid present exact PTS after the qualifying interval",
    "end": "first of three consecutive processed frames with presence true and major-bone angular error at most 30 degrees",
    "stableProcessedFrames": 3,
    "majorBoneErrorMaxDeg": 30,
    "finalMaximumMs": 150
  },
  "endpoints": {
    "names": [
      "leftWrist",
      "rightWrist",
      "leftAnkle",
      "rightAnkle",
      "head"
    ],
    "denominator": "teacher-observable exact-paired live/avatar states per endpoint",
    "minimumCoveragePerEndpoint": 0.9,
    "finalP95AvatarHeightRatioMax": 0.04
  },
  "confidenceUpdate": {
    "canonicalJointConfidenceRange": [
