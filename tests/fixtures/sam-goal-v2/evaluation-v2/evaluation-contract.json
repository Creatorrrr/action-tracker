      "contact": "class_per_clip_per_foot_macro_14",
      "observability": "field_per_clip_macro",
      "zeroVariance": "one_if_identical_constants_else_zero",
      "adjudicatedRowsForbiddenAsPassInput": true,
      "minimum": { "presencePersonStateKappa": 0.99, "contactKappa": 0.9, "observabilityKappa": 0.95 }
    },
    "automatedCandidateMayClaimReviewedOrAdjudicated": false
  },
  "contactPolicy": {
