    "observable_endpoint_forbidden_for_occluded_out_of_frame_or_unknown_part",
    "multiple_people_requires_selected_with_anchor_or_ambiguous_subject",
    "single_target_requires_selected_subject",
    "one_manual_and_subject_row_per_decoder_identity"
  ],
  "manualReview": {
    "passes": ["manual-review-pass1.jsonl", "manual-review-pass2.jsonl"],
    "adjudication": "manual-adjudication.jsonl",
    "independentSubjectFields": ["subjectSelection.state", "subjectSelection.manualTargetId", "subjectSelection.anchor"],
    "subjectReviewRule": "both complete pre-adjudication passes independently record subject state, stable manual target ID, and normalized anchor on every exact decoder identity; every subject disagreement is explicitly adjudicated and the agreed/adjudicated result must equal manual-subject-selection",
    "subjectFieldsExcludedFromKappaButNotFromReview": true,
    "distinctReviewerHashes": true,
    "completeRowsPerPass": 6711,
    "adjudicateAllDisagreements": true,
