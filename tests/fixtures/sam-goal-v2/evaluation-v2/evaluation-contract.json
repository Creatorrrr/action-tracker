    "minimumHardTestClips": 2,
    "minimumUnreliableIntervalMs": 200,
    "intervalConvention": "start_inclusive_end_exclusive",
    "statePredicates": {
      "absent": "manual presence=absent and subjectSelection=absent",
      "unreliable": "manual presence=unknown, or subjectSelection is ambiguous/unknown, or occlusion.body is occluded/out_of_frame/unknown",
      "reliable": "manual presence=present, subjectSelection=selected, and occlusion.body is observable/partial"
    },
    "p0CandidateMaterialization": "a maximal contiguous interval [startPts,endPts) in which every exact decoder identity satisfies absent or unreliable, lasting at least 200ms in exact rational PTS, followed by the first decoder identity at or after endPts satisfying reliable",
    "deduplication": "one event per maximal qualifying interval; overlapping/nested intervals merge, adjacent intervals merge when no present decoder identity lies between them, and each start identity is unique",
    "maximalIntervalsOnly": true,
    "uniqueStartIdentity": true,
    "p1Start": "first_teacher_valid_present_identity_at_or_after_candidate_end",
    "latencyEnd": "first_three_consecutive_processed_presence_true_and_major_bone_error_lte_30deg"
  },
  "teacherValidity": {
    "ruleId": "sam_goal.teacher_valid@v2",
    "nativeJointConfidenceAbsentInCurrentTeacher": true,
    "neverImputeNativeJointConfidence": true,
    "warningCodes": ["native_joint_confidence_unavailable"],
    "forbiddenExclusionReasons": ["confidence_unavailable"],
    "requiredMaskFields": ["jointConfidenceSource", "scope.contactEligibility", "warningCodes"],
    "confidenceUnavailableIsWarningNotExclusion": true,
    "calibrationWithoutNativeConfidence": false,
    "validFullBodyContactMayBeTrueWhenConfidenceAvailableFalse": true,
    "detectorScoreMustNotBecomeJointConfidence": true,
    "truthRules": [
      "jointConfidenceSource is native iff confidenceAvailable is true; it is unavailable iff confidenceAvailable is false",
      "valid false requires torsoFacing/fullBody/calibration and both contactEligibility feet false plus at least one exclusion reason",
      "valid true requires teacherRecord present, selectedSubject selected, at least one of torsoFacing/fullBody/calibration/contactEligibility true, and zero exclusion reasons",
      "torsoFacing/fullBody/calibration true each imply valid true",
      "torsoFacing without native confidence requires finite torso coordinates, manual torso observability, and a valid geometric basis",
      "fullBody without native confidence requires finite required coordinates, in-frame projection, manual body and limb observability, selected subject, and bone/scale/speed/temporal guards",
      "either contactEligibility foot true implies fullBody true and valid true",
      "calibration true implies fullBody true",
      "a contactEligibility foot true requires manual presence present, that foot observable, known planted/moving contact, finite required leg chain, and temporal guards",
      "confidenceAvailable false requires warning native_joint_confidence_unavailable, forbids calibration true, and forbids exclusion reason confidence_unavailable",
      "confidenceAvailable true forbids warning native_joint_confidence_unavailable",
      "warning codes never satisfy the required nonempty exclusion reasons of an invalid row and never make a valid row invalid",
      "native_joint_confidence_unavailable alone cannot disable torsoFacing, fullBody, or contactEligibility when their geometric/manual conditions pass",
      "detector score provenance is detector only; no joint confidence array/value may claim detector score as native confidence"
    ]
  },
